# Public browser configuration only. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
# Existing SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY names remain supported by next.config.ts.
