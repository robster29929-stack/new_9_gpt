{
  "name": "new-9-gpt",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run test:core && npm run test:legacy",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run",
    "test:legacy": "node tests/smoke.cjs && node --test tests/persistence.test.cjs tests/auth.test.cjs",
    "test:e2e": "playwright test",
    "check:foundation": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "supabase": "2.121.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
